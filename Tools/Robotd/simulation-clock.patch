 impl RobotIo for RemoteIo {
+    fn begin_tick(&mut self, period: Duration) -> Result<Option<crate::io::SimulationTick>> {
+        if !self.lockstep {
+            return Ok(None);
+        }
+        let frame: TickReply = self.call(&Request::Tick {
+            period_us: period.as_micros() as u64,
+        })?;
+        let time = Duration::from_micros(frame.time_us);
+        if frame.advance {
+            if let Some(last) = self.last_tick {
+                if time != last + period {
+                    return Err(IoError::Bus(format!(
+                        "simulation clock jumped from {last:?} to {time:?}; expected {:?}",
+                        last + period
+                    )));
+                }
+            }
+            self.last_tick = Some(time);
+        }
+        Ok(Some(crate::io::SimulationTick {
+            time,
+            advance: frame.advance,
+        }))
+    }
+    fn end_tick(&mut self) -> Result<()> {
+        if !self.lockstep {
+            return Ok(());
+        }
+        let ack: Ack = self.call(&Request::Commit)?;
+        acked(ack, "control tick")
+    }
+
     fn read(&mut self) -> Result<Sensors> {
