+    fn lockstep_waits_commits_and_checks_its_clock() {
+        let (addr, sim) = simulator(vec![vec![
+            r#"{"protocol":2}"#,
+            r#"{"time_us":0,"advance":false}"#,
+            r#"{"time_us":0,"advance":true}"#,
+            "{}",
+            r#"{"time_us":20000,"advance":true}"#,
+            "{}",
+            r#"{"time_us":20000,"advance":true}"#,
+        ]]);
+        let mut io = RemoteIo::at(addr).with_lockstep(true);
+        let dt = Duration::from_millis(20);
+        assert!(!io.begin_tick(dt).unwrap().unwrap().advance);
+        assert_eq!(io.begin_tick(dt).unwrap().unwrap().time, Duration::ZERO);
+        io.end_tick().unwrap();
+        assert_eq!(io.begin_tick(dt).unwrap().unwrap().time, dt);
+        io.end_tick().unwrap();
+        assert!(
+            io.begin_tick(dt)
+                .unwrap_err()
+                .to_string()
+                .contains("clock jumped")
+        );
+        let heard = sim.join().unwrap();
+        assert!(heard[0].contains(r#""protocol":2"#));
+        assert!(heard[1].contains(r#""period_us":20000"#));
+        assert!(heard[3].contains("commit"));
+    }
