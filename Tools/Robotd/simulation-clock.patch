+/// A simulator-controlled control boundary. Waiting does not execute another control tick.
+#[derive(Debug, Clone, Copy)]
+pub struct SimulationTick {
+    pub time: std::time::Duration,
+    pub advance: bool,
+}
+
 pub trait RobotIo {
+    /// Optional lockstep pacing. Hardware and protocol-1 simulators keep the wall-clock ticker.
+    fn begin_tick(&mut self, _period: std::time::Duration) -> Result<Option<SimulationTick>> {
+        Ok(None)
+    }
+    fn end_tick(&mut self) -> Result<()> {
+        Ok(())
+    }
+
     /// One transaction: joints and IMU together.
     fn read(&mut self) -> Result<Sensors>;
     fn write(&mut self, targets: &JointTargets) -> Result<()>;
